<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/iconWS.png" type="image/png">
    <title>Dịch Thuật Tài Liệu</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Roboto', 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .content {
            padding: 40px;
        }

        .section {
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 1.5em;
            color: #667eea;
            margin-bottom: 20px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .upload-area {
            border: 3px dashed #667eea;
            border-radius: 10px;
            padding: 40px;
            text-align: center;
            background: #f8f9fa;
            cursor: pointer;
            transition: all 0.3s;
        }

        .upload-area:hover {
            background: #e9ecef;
            border-color: #764ba2;
        }

        .upload-area.dragover {
            background: #e3f2fd;
            border-color: #2196f3;
        }

        .upload-icon {
            font-size: 4em;
            color: #667eea;
            margin-bottom: 20px;
        }

        .upload-text {
            font-size: 1.2em;
            color: #495057;
            margin-bottom: 10px;
        }

        .upload-hint {
            font-size: 0.9em;
            color: #6c757d;
        }

        #fileInput {
            display: none;
        }

        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-success {
            background: #28a745;
            color: white;
        }

        .btn-success:hover {
            background: #218838;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn-danger:hover {
            background: #c82333;
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .text-area-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 20px;
        }

        .text-area-wrapper {
            display: flex;
            flex-direction: column;
        }

        .text-area-label {
            font-weight: bold;
            color: #495057;
            margin-bottom: 10px;
            font-size: 1.1em;
        }

        .text-area {
            width: 100%;
            min-height: 400px;
            padding: 15px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            font-family: 'Roboto', sans-serif;
            resize: vertical;
            transition: border-color 0.3s;
        }

        .text-area:focus {
            outline: none;
            border-color: #667eea;
        }

        .text-area.readonly {
            background: #f8f9fa;
            cursor: not-allowed;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .file-info {
            background: #e3f2fd;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
        }

        .file-info.show {
            display: block;
        }

        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s linear infinite;
            margin-right: 10px;
            vertical-align: middle;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .alert {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
        }

        .alert.show {
            display: block;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .back-button {
            display: inline-block;
            margin: 20px;
            padding: 12px 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .back-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }

        /* Responsive cho mobile */
        @media screen and (max-width: 768px) {
            body {
                padding: 10px;
            }

            .header h1 {
                font-size: 1.8em;
            }

            .content {
                padding: 20px 15px;
            }

            .text-area-container {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .text-area {
                min-height: 300px;
            }

            .action-buttons {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <a href="/" class="back-button">
        <i class="fas fa-arrow-left"></i> Quay lại trang chủ
    </a>

    <div class="container">
        <div class="header">
            <h1><i class="fas fa-language"></i> Dịch Thuật Tài Liệu</h1>
            <p>Dịch từ Trung-Anh sang Tiếng Việt</p>
        </div>

        <div class="content">
            <!-- Alert messages -->
            <div id="alertMessage" class="alert"></div>

            <!-- Upload Section -->
            <div class="section">
                <div class="section-title">
                    <i class="fas fa-upload"></i> Tải lên file PDF
                </div>
                <div class="upload-area" id="uploadArea">
                    <div class="upload-icon">
                        <i class="fas fa-file-pdf"></i>
                    </div>
                    <div class="upload-text">Kéo thả file PDF vào đây hoặc click để chọn</div>
                    <div class="upload-hint">Chỉ chấp nhận file PDF (tối đa 10MB)</div>
                    <input type="file" id="fileInput" accept=".pdf" />
                </div>
                <div class="file-info" id="fileInfo"></div>
            </div>

            <!-- Translation Section -->
            <div class="section">
                <div class="section-title">
                    <i class="fas fa-exchange-alt"></i> Dịch Thuật
                </div>
                <div class="text-area-container">
                    <div class="text-area-wrapper">
                        <label class="text-area-label">
                            <i class="fas fa-file-alt"></i> Nội dung gốc (Trung-Anh)
                        </label>
                        <textarea id="sourceText" class="text-area" placeholder="Nhập hoặc upload file PDF để lấy nội dung..."></textarea>
                    </div>
                    <div class="text-area-wrapper">
                        <label class="text-area-label">
                            <i class="fas fa-language"></i> Nội dung đã dịch (Tiếng Việt)
                        </label>
                        <textarea id="translatedText" class="text-area" placeholder="Nhập bản dịch tiếng Việt tại đây..."></textarea>
                    </div>
                </div>
                <div class="action-buttons">
                    <button class="btn btn-primary" id="translateBtn" onclick="translateText()">
                        <i class="fas fa-sync-alt"></i> Dịch tự động
                    </button>
                    <button class="btn btn-success" id="saveBtn" onclick="saveTranslation()">
                        <i class="fas fa-save"></i> Lưu file đã dịch
                    </button>
                    <button class="btn btn-danger" id="clearBtn" onclick="clearAll()">
                        <i class="fas fa-trash"></i> Xóa tất cả
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('fileInput');
        const sourceText = document.getElementById('sourceText');
        const translatedText = document.getElementById('translatedText');
        const fileInfo = document.getElementById('fileInfo');
        const alertMessage = document.getElementById('alertMessage');

        // Click vào upload area
        uploadArea.addEventListener('click', () => {
            fileInput.click();
        });

        // Drag and drop
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('dragover');
        });

        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            const files = e.dataTransfer.files;
            if (files.length > 0 && files[0].type === 'application/pdf') {
                handleFileUpload(files[0]);
            } else {
                showAlert('Vui lòng chọn file PDF!', 'error');
            }
        });

        // File input change
        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                handleFileUpload(e.target.files[0]);
            }
        });

        // Xử lý upload file
        async function handleFileUpload(file) {
            if (file.type !== 'application/pdf') {
                showAlert('Chỉ chấp nhận file PDF!', 'error');
                return;
            }

            if (file.size > 10 * 1024 * 1024) {
                showAlert('File quá lớn! Tối đa 10MB', 'error');
                return;
            }

            const formData = new FormData();
            formData.append('pdfFile', file);

            const translateBtn = document.getElementById('translateBtn');
            translateBtn.disabled = true;
            translateBtn.innerHTML = '<span class="loading"></span>Đang đọc file...';

            try {
                const response = await fetch('/api/translate/upload', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    sourceText.value = data.text;
                    fileInfo.innerHTML = `
                        <strong><i class="fas fa-info-circle"></i> Thông tin file:</strong><br>
                        Tên file: ${file.name}<br>
                        Số trang: ${data.numPages}<br>
                        Kích thước: ${(file.size / 1024).toFixed(2)} KB
                    `;
                    fileInfo.classList.add('show');
                    showAlert('Đã đọc file PDF thành công!', 'success');
                } else {
                    showAlert(data.error || 'Không thể đọc file PDF', 'error');
                }
            } catch (error) {
                console.error('Lỗi upload:', error);
                showAlert('Có lỗi xảy ra khi đọc file. Vui lòng thử lại.', 'error');
            } finally {
                translateBtn.disabled = false;
                translateBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Dịch tự động (sắp có)';
            }
        }

        // Dịch text tự động
        async function translateText() {
            const text = sourceText.value.trim();
            if (!text) {
                showAlert('Vui lòng nhập hoặc upload nội dung cần dịch!', 'error');
                return;
            }

            const translateBtn = document.getElementById('translateBtn');
            translateBtn.disabled = true;
            translateBtn.innerHTML = '<span class="loading"></span>Đang dịch...';

            try {
                const response = await fetch('/api/translate/text', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        sourceText: text, 
                        sourceLang: 'zh', 
                        targetLang: 'vi' 
                    })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    translatedText.value = data.translatedText;
                    showAlert('Đã dịch thành công!', 'success');
                } else {
                    showAlert(data.error || 'Không thể dịch tự động. Vui lòng nhập bản dịch thủ công.', 'error');
                }
            } catch (error) {
                console.error('Lỗi dịch:', error);
                showAlert('Có lỗi xảy ra khi dịch. Vui lòng thử lại hoặc nhập bản dịch thủ công.', 'error');
            } finally {
                translateBtn.disabled = false;
                translateBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Dịch tự động';
            }
        }

        // Lưu file đã dịch
        async function saveTranslation() {
            const original = sourceText.value.trim();
            const translated = translatedText.value.trim();

            if (!translated) {
                showAlert('Vui lòng nhập nội dung đã dịch!', 'error');
                return;
            }

            const fileName = prompt('Nhập tên file (không cần đuôi):', 'translated');
            if (!fileName) return;

            const saveBtn = document.getElementById('saveBtn');
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="loading"></span>Đang lưu...';

            try {
                const response = await fetch('/api/translate/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        originalText: original,
                        translatedText: translated,
                        fileName: fileName
                    })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    showAlert(`Đã lưu file thành công! <a href="${data.pdfUrl}" target="_blank" style="color: #155724; text-decoration: underline;">Tải PDF</a> | <a href="${data.txtUrl}" target="_blank" style="color: #155724; text-decoration: underline;">Tải TXT</a>`, 'success');
                } else {
                    showAlert(data.error || 'Không thể lưu file', 'error');
                }
            } catch (error) {
                console.error('Lỗi lưu file:', error);
                showAlert('Có lỗi xảy ra khi lưu file. Vui lòng thử lại.', 'error');
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="fas fa-save"></i> Lưu file đã dịch';
            }
        }

        // Xóa tất cả
        function clearAll() {
            if (confirm('Bạn có chắc chắn muốn xóa tất cả nội dung?')) {
                sourceText.value = '';
                translatedText.value = '';
                fileInfo.classList.remove('show');
                fileInfo.innerHTML = '';
                fileInput.value = '';
                hideAlert();
            }
        }

        // Hiển thị alert
        function showAlert(message, type) {
            alertMessage.textContent = '';
            alertMessage.className = `alert alert-${type} show`;
            alertMessage.innerHTML = message;
            setTimeout(() => {
                hideAlert();
            }, 5000);
        }

        // Ẩn alert
        function hideAlert() {
            alertMessage.classList.remove('show');
        }
    </script>
</body>
</html>

