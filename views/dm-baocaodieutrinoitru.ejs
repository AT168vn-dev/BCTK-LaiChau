<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>THỐNG KÊ ĐIỀU TRỊ NỘI TRÚ</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        /* Định dạng chung cho phần form chọn ngày */
        #dateRangeForm {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            background-color: #ffffff;
            border-radius: 8px;
            padding: 10px 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 10px;
        }

        /* Định dạng các ô input ngày và giờ */
        /* Định dạng các trường ngày giờ với màu và độ đậm hơn */
        #dateRangeForm label {
            font-weight: bold;
            color: #333;
            /* Màu chữ đậm, xám than */
        }

        #startDateDTNoiTru,
        #endDateDTNoiTru {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 16px;
            height: 18px;
            outline: none;
            transition: border-color 0.3s ease, color 0.3s ease;
            font-weight: bold;
            /* Đậm chữ */
            color: #1a73e8;
            /* Màu xanh dương nhạt */
            background-color: #ffffff;
            /* Nền trắng */
        }

        #startTimeDTNoiTru,
        #endTimeDTNoiTru {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 16px;
            height: 18px;
            outline: none;
            transition: border-color 0.3s ease, color 0.3s ease;
            font-weight: bold;
            /* Đậm chữ */
            color: #d20913bd;
            /* Màu xanh dương nhạt */
            background-color: #ffffff;
            /* Nền trắng */
        }

        #startDateDTNoiTru:focus,
        #startTimeDTNoiTru:focus,
        #endDateDTNoiTru:focus,
        #endTimeDTNoiTru:focus {
            border-color: #1a73e8;
            /* Bo viền xanh dương khi chọn */
            box-shadow: 0 0 5px rgba(26, 115, 232, 0.5);
        }

        /* Style cho các ô date theo chuẩn Google */
        #dateRangeForm input[type="date"],
        #dateRangeForm input[type="text"] {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            height: 18px;
            outline: none;
            transition: border-color 0.3s ease;
        }

        /* Khi input được chọn, bo viền màu xanh */
        #dateRangeForm input[type="date"]:focus,
        #dateRangeForm input[type="text"]:focus {
            border-color: #4285f4;
            box-shadow: 0 0 5px rgba(66, 133, 244, 0.5);
        }

        /* Điều chỉnh chiều rộng ngắn hơn cho startTimeDTNoiTru và endTimeDTNoiTru */
        #startTimeDTNoiTru,
        #endTimeDTNoiTru {
            width: 80px;
            /* Chiều rộng nhỏ hơn */
            text-align: center;
            /* Căn giữa văn bản bên trong */
        }

        #startDateDTNoiTru,
        #endDateDTNoiTru {
            width: 130px;
            /* Chiều rộng nhỏ hơn */
            text-align: center;
            /* Căn giữa văn bản bên trong */
        }

        #zButtonDTNoiTru {
            font-size: 14px;
            padding: 5px 10px;
            cursor: pointer;
            background-color: #2e7d32;
            /* Màu xanh đậm */
            color: #e0f7fa;
            /* Màu chữ sáng hơn */
            border: none;
            border-radius: 4px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        #zButtonDTNoiTru:hover {
            background-color: #074705;
            /* Màu nền xanh đậm hơn khi rê chuột vào */
            color: #e1ee2e;
            /* Chữ màu trắng sáng khi rê chuột vào */
        }

        .table-panel {
            width: 100%;
            overflow-y: auto;
            border: 1px solid #ccc;
            padding: 0;
        }

        /* Style for the entire table */
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            border: 1px solid #D3D3D3;
        }

        /* Header styling - keeping it as original */
        table thead th {
            background-color: #2e66e9;
            color: white;
            padding: 12px;
            /* Original padding for headers */
            text-align: center;
            font-size: 14px;
            /* Original font size for headers */
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
            border: 1px solid #D3D3D3;
        }

        /* Compact styling for table body cells */
        table tbody td {
            padding: 4px 6px;
            /* Điều chỉnh giá trị này để tăng chiều cao */
            font-size: 12px;
            text-align: center;
            border: 1px solid #D3D3D3;
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
        }

        /* Nếu muốn tăng độ cao cụ thể mà không phụ thuộc vào padding */
        table tbody tr {
            height: 26px;
            /* Tăng chiều cao của mỗi hàng, điều chỉnh giá trị theo ý muốn */
        }

        /* Left-align for "Tên Phòng Khám" column */
        .hrl_name {
            text-align: left;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Right-align for currency columns */
        .currency {
            text-align: right;
            font-size: 12px;
        }

        /* Định dạng các hàng để chia đều */
        table tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        table tbody tr:hover {
            background-color: #e6f7ff;
        }

        .sidebar.hidden {
            display: none;
        }

        .content.expanded {
            width: 100%;
            padding-left: 0;
            transition: width 0.3s ease;
        }

        .total-row td {
            font-weight: bold !important;
        }
    </style>
</head>

<body>

    <h1>THỐNG KÊ HOẠT ĐỘNG ĐIỀU TRỊ NỘI TRÚ</h1>

    <form id="dateRangeForm">
        <label for="startDateDTNoiTru">Từ ngày: </label>
        <input type="text" name="startDateDTNoiTru" id="startDateDTNoiTru" value="<%= startDateBCDTNoiTru %>"
            placeholder="dd/MM/yyyy" />
        <input type="text" id="startTimeDTNoiTru" name="startTimeDTNoiTru" value="07:30"
            pattern="^([01]\d|2[0-3]):([0-5]\d)$" title="Nhập thời gian theo định dạng HH:MM">

        <label for="endDateDTNoiTru">Đến ngày: </label>
        <input type="text" name="endDateDTNoiTru" id="endDateDTNoiTru" value="<%= endDateBCDTNoiTru %>"
            placeholder="dd/MM/yyyy" />
        <input type="text" id="endTimeDTNoiTru" name="endTimeDTNoiTru" value="07:29"
            pattern="^([01]\d|2[0-3]):([0-5]\d)$" title="Nhập thời gian theo định dạng HH:MM">

        <button type="button" id="zButtonDTNoiTru">Lấy Báo Cáo</button>
    </form>

    <div>
        <h2>THỐNG KÊ CHI TIẾT ĐIỀU TRỊ NỘI TRÚ</h2>

        <div class="table-panel">
            <table>
                <thead>
                    <tr>
                        <th rowspan="3" style="width: 3%;">STT</th>
                        <th rowspan="3" style="width: 27%;">Tên Khoa Phòng</th>
                        <th colspan="10" style="width: 70%;">Điều Trị Nội Trú</th>
                    </tr>
                    <tr>
                        <th rowspan="3">Đầu Kỳ</th>
                        <th rowspan="3">Vào Viện</th>
                        <th rowspan="3">Ra Viện</th>
                        <th colspan="2">Chuyển Khoa</th>
                        <th rowspan="3">Chuyển Viện</th>
                        <th rowspan="3">Có BHYT</th>
                        <th rowspan="3">Cấp Cứu</th>
                        <th rowspan="3">Tử Vong</th>
                        <th rowspan="3">Cuối kỳ</th>
                    </tr>
                    <tr>
                        <th>Đến</th>
                        <th>Đi</th>
                    </tr>
                </thead>
                <tbody id="table-body-chitietdieutrinoitru">
                    <!-- Nội dung bảng sẽ được chèn vào đây -->
                </tbody>
                <tbody id="table-body2-chitietdieutrinoitru" class="total-row">
                    <!-- Nội dung bảng sẽ được chèn vào đây -->
                </tbody>
            </table>
        </div>
    </div>

    <div>
        <h2>THỐNG KÊ CHI TIẾT ĐIỀU TRỊ NGOẠI TRÚ TRONG KHOA</h2>

        <div class="table-panel">
            <table>
                <thead>
                    <tr>
                        <th rowspan="3" style="width: 3%;">STT</th>
                        <th rowspan="3" style="width: 27%;">Tên Khoa Phòng</th>
                        <th colspan="9" style="width: 70%;">Điều Trị Ngoại Trú Trong Khoa</th>
                    </tr>
                    <tr>
                        <th rowspan="3">Đầu Kỳ</th>
                        <th rowspan="3">Vào Viện</th>
                        <th rowspan="3">Ra Viện</th>
                        <th colspan="2">Chuyển Khoa</th>
                        <th rowspan="3">Chuyển Viện</th>
                        <th rowspan="3">Cấp Cứu</th>
                        <th rowspan="3">Tử Vong</th>
                        <th rowspan="3">Cuối kỳ</th>
                    </tr>
                    <tr>
                        <th>Đến</th>
                        <th>Đi</th>
                    </tr>
                </thead>
                <tbody id="table-body-chitietdieutringoaitrutrongkhoa">
                    <!-- Nội dung bảng sẽ được chèn vào đây -->
                </tbody>
                <tbody id="table-body2-chitietdieutringoaitrutrongkhoa" class="total-row">
                    <!-- Nội dung bảng sẽ được chèn vào đây -->
                </tbody>
            </table>
        </div>
    </div>

    <script src="/js/scripts.js"></script>
</body>

</html>