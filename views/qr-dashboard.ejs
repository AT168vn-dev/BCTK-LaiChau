    <script>
        /**
         * Hàm in với Microsoft Print to PDF - Chất lượng tốt nhất
         */
        function printWithMicrosoftPDF() {
            const oldOverlays = document.querySelectorAll('.print-overlay, .print-modal');
            oldOverlays.forEach(el => el.remove());

            function removeOverlay() {
                const overlay = document.querySelector('.print-overlay');
                const modal = document.querySelector('.print-modal');
                if (overlay) overlay.remove();
                if (modal) modal.remove();
            }

            const instructions = `
                <div class="print-modal" style="
                    position: fixed;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    background: white;
                    padding: 30px;
                    border-radius: 10px;
                    box-shadow: 0 10px 40px rgba(0,0,0,0.3);
                    z-index: 10000;
                    max-width: 500px;
                    text-align: left;
                ">
                    <h3 style="color: #667eea; margin-bottom: 15px;">
                        <i class="fas fa-info-circle"></i> Hướng dẫn in PDF
                    </h3>
                    <ol style="line-height: 2; color: #495057;">
                        <li>Trong hộp thoại in, chọn <strong>"Microsoft Print to PDF"</strong> hoặc <strong>"Save as PDF"</strong></li>
                        <li>Chọn <strong>"More settings"</strong> và đảm bảo:</li>
                        <ul style="margin-left: 20px; margin-top: 10px;">
                            <li>Margins: <strong>Default</strong> hoặc <strong>Minimum</strong></li>
                            <li>Scale: <strong>100%</strong></li>
                            <li>Background graphics: <strong>Bật</strong> (quan trọng!)</li>
                        </ul>
                        <li>Nhấn <strong>"Save"</strong> để lưu PDF</li>
                    </ol>
                    <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: flex-end;">
                        <button onclick="removeOverlay(); window.print();" 
                                style="padding: 10px 20px; background: #667eea; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">
                            Tiếp tục in
                        </button>
                        <button onclick="removeOverlay();" 
                                style="padding: 10px 20px; background: #6c757d; color: white; border: none; border-radius: 5px; cursor: pointer;">
                            Hủy
                        </button>
                    </div>
                </div>
                <div class="print-overlay" style="
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0,0,0,0.5);
                    z-index: 9999;
                " onclick="removeOverlay();"></div>
            `;

            document.body.insertAdjacentHTML('beforeend', instructions);
            window.removeOverlay = removeOverlay;
        }

        /**
         * Hàm xuất PDF trực tiếp bằng html2pdf.js
         */
        function exportToPDF() {
            const element = document.getElementById("pdfContent");

            const loading = document.createElement("div");
            loading.innerHTML = `
                <div style="
                    position: fixed;
                    top:0; left:0; width:100%; height:100%;
                    background: rgba(255,255,255,0.9);
                    display:flex; align-items:center; justify-content:center;
                    font-size:22px; font-weight:bold; color:#444;
                    z-index:9999;
                    flex-direction: column;
                    gap: 20px;
                ">
                    <div>Đang tạo PDF, vui lòng chờ...</div>
                    <div style="font-size: 14px; color: #666;">
                        <i class="fas fa-info-circle"></i> 
                        Để có chất lượng tốt nhất, hãy sử dụng nút "In với Microsoft Print to PDF"
                    </div>
                </div>
            `;
            document.body.appendChild(loading);

            const opt = {
                margin: [10, 10, 10, 10],
                filename: 'BaoCaoKhamSucKhoe_' + new Date().toISOString().split('T')[0] + '.pdf',
                image: {
                    type: 'jpeg',
                    quality: 0.98
                },
                html2canvas: {
                    scale: 4,
                    useCORS: true,
                    logging: false,
                    dpi: 300,
                    letterRendering: true,
                    backgroundColor: '#ffffff',
                    windowWidth: element.scrollWidth,
                    windowHeight: element.scrollHeight,
                    allowTaint: false,
                    foreignObjectRendering: true
                },
                jsPDF: {
                    unit: 'mm',
                    format: 'a4',
                    orientation: 'portrait',
                    compress: false
                },
                pagebreak: {
                    mode: ['avoid-all', 'css', 'legacy'],
                    before: '.section',
                    after: '.footer',
                    avoid: ['table', 'tr', '.summary-box']
                }
            };

            html2pdf().set(opt).from(element)
                .save()
                .then(() => {
                    loading.remove();
                })
                .catch((error) => {
                    console.error('Lỗi khi xuất PDF:', error);
                    alert('Có lỗi xảy ra khi xuất PDF. Vui lòng thử lại hoặc sử dụng nút "In với Microsoft Print to PDF" để có chất lượng tốt hơn.');
                    loading.remove();
                });
        }

        // Phím tắt Ctrl+P
        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
                e.preventDefault();
                printWithMicrosoftPDF();
            }
        });
    </script>
