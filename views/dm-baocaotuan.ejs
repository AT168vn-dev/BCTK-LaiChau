<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>THỐNG KÊ THEO TUẦN</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        /* CSS styling cho giao diện */
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        /* Định dạng chung cho phần form chọn ngày */
        #dateRangeForm {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            background-color: #ffffff;
            border-radius: 8px;
            padding: 10px 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 10px;
        }

        /* Định dạng các ô input ngày và giờ */
        /* Định dạng các trường ngày giờ với màu và độ đậm hơn */
        #dateRangeForm label {
            font-weight: bold;
            color: #333;
            /* Màu chữ đậm, xám than */
        }

        #startDate,
        #endDate {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 16px;
            height: 18px;
            outline: none;
            transition: border-color 0.3s ease, color 0.3s ease;
            font-weight: bold;
            /* Đậm chữ */
            color: #1a73e8;
            /* Màu xanh dương nhạt */
            background-color: #ffffff;
            /* Nền trắng */
        }

        #startTime,
        #endTime {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 16px;
            height: 18px;
            outline: none;
            transition: border-color 0.3s ease, color 0.3s ease;
            font-weight: bold;
            /* Đậm chữ */
            color: #d20913bd;
            /* Màu xanh dương nhạt */
            background-color: #ffffff;
            /* Nền trắng */
        }

        #startDate:focus,
        #startTime:focus,
        #endDate:focus,
        #endTime:focus {
            border-color: #1a73e8;
            /* Bo viền xanh dương khi chọn */
            box-shadow: 0 0 5px rgba(26, 115, 232, 0.5);
        }

        /* Style cho các ô date theo chuẩn Google */
        #dateRangeForm input[type="date"],
        #dateRangeForm input[type="text"] {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            height: 18px;
            outline: none;
            transition: border-color 0.3s ease;
        }

        /* Khi input được chọn, bo viền màu xanh */
        #dateRangeForm input[type="date"]:focus,
        #dateRangeForm input[type="text"]:focus {
            border-color: #4285f4;
            box-shadow: 0 0 5px rgba(66, 133, 244, 0.5);
        }

        /* Điều chỉnh chiều rộng ngắn hơn cho startTime và endTime */
        #startTime,
        #endTime {
            width: 80px;
            /* Chiều rộng nhỏ hơn */
            text-align: center;
            /* Căn giữa văn bản bên trong */
        }

        #startDate,
        #endDate {
            width: 130px;
            /* Chiều rộng nhỏ hơn */
            text-align: center;
            /* Căn giữa văn bản bên trong */
        }

        canvas {
            max-width: 800px;
            margin: auto;
        }

        #loadReportButton {
            font-size: 14px;
            padding: 5px 10px;
            cursor: pointer;
            background-color: #2e7d32;
            /* Màu xanh đậm */
            color: #e0f7fa;
            /* Màu chữ sáng hơn */
            border: none;
            border-radius: 4px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        #loadReportButton:hover {
            background-color: #074705;
            /* Màu nền xanh đậm hơn khi rê chuột vào */
            color: #e1ee2e;
            /* Chữ màu trắng sáng khi rê chuột vào */
        }
    </style>
</head>

<body>
    <h1>THỐNG KÊ HOẠT ĐỘNG THEO TUẦN</h1>

    <!-- Form chọn khoảng thời gian trong 7 ngày -->
    <form id="dateRangeForm">
        <label for="startDate">Từ ngày: </label>
        <input type="text" name="startDate" id="startDate" value="<%= defaultDate %>" placeholder="dd/MM/yyyy" />
        
        <label for="endDate">Đến ngày: </label>
        <input type="text" name="endDate" id="endDate" value="<%= defaultDate %>" placeholder="dd/MM/yyyy" />
       
        <button type="button" id="loadReportButton">Lấy Báo Cáo</button>
      </form>

    <div>
        <canvas id="weeklyReportChart" style="width:100%;max-width:1000px"></canvas>
    </div>

    <script src="/js/scripts.js"></script>
</body>

</html>