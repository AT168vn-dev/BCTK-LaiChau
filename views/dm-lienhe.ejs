            style="padding: 10px; background-color: #f1f1f1; text-align: center; margin-top: 20px; border-top: 1px solid #ddd;">
            <div style="display: flex; justify-content: space-between; text-align: left;">
                <!-- Phần giới thiệu -->
                <div style="padding-right: 10px;">
                    <h2>
                        <p><strong>HỆ THỐNG QUẢN LÝ BÁO CÁO THỐNG KÊ</strong></p>
