                                <i class="fas fa-procedures"></i>
                                Điều Trị Nội Trú
                            </li>
                            <li onclick="loadBaoCaoCLS();" id="menuBaoCaoCLS" class="menu-item">
                                <i class="fas fa-microscope"></i>
                                Cận lâm sàng
                            </li>
                            <li onclick="loadBaoCaopttt();" id="menuBaoCaoPTTT" class="menu-item">
                                <i class="fas fa-joint"></i>
                                Phẫu thuật thủ thuật
                            </li>
                            <li onclick="loadBaoCaoChiPhiTheoKhoaPhong();" id="menuBaoCaoChiPhi" class="menu-item">
                                <i class="fa-solid fa-money-check-dollar"></i>
                                Tổng hợp chi phí theo khoa phòng
                            </li>
                            <li onclick="loadBaoCaoCongSuatGiuong();" id="menuBaoCaoCongSuat" class="menu-item">
                                <i class="fa-solid fa-person-booth"></i>
                                Công suất giường
                            </li>
                        </ul>

                        <li onclick="toggleMenu('menu4', this)">
                            <i class="fas"></i>
                            Dashboard
                            <span class="arrow" id="arrow-menu4">▶</span>
                        </li>

                        <ul id="menu4" class="submenu">
                            <li onclick="loadBaoCaoNgay()">
                                <i class="fas fa-chart-line"></i>
                                Báo cáo ngày
                            </li>
