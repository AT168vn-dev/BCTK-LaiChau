                        <!-- <li onclick="loadPdfToWord()">
                            <i class="fas fa-file-word"></i>
                            PDF -> Word
                        </li> -->
            </ul>
        </div>

        <!-- Khung hiển thị nội dung -->
        <div class="content" id="content-area">
            <!-- Nội dung sẽ được tải vào đây -->
        </div>
    </div>

    <!-- Thêm div loading overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-spinner"></div>
        <div class="loading-text">Đang tải dữ liệu...</div>
    </div>

    <script>
        // Đóng tất cả các menu con
        function closeAllMenus() {
            const submenus = document.querySelectorAll('.submenu');
            submenus.forEach(menu => {
                menu.style.maxHeight = '0'; // Đóng menu con
            });

            const arrows = document.querySelectorAll('.arrow');
            arrows.forEach(arrow => {
                arrow.innerHTML = '▶'; // Đổi tất cả mũi tên về trạng thái ngang
            });

            const menuItems = document.querySelectorAll('.sidebar ul li');
            menuItems.forEach(item => item.classList.remove('active')); // Bỏ active khỏi tất cả menu mẹ
        }

        // Mở menu và đóng các menu con khác, thay đổi mũi tên
        function toggleMenu(menuId, menuItem) {
            const menu = document.getElementById(menuId);
            const arrow = document.getElementById('arrow-' + menuId);

            if (menu.style.maxHeight === '0px' || menu.style.maxHeight === '') {
                closeAllMenus(); // Đóng các menu khác
                menu.style.maxHeight = menu.scrollHeight + 'px'; // Mở menu con
                arrow.innerHTML = '▼'; // Mũi tên xuống khi mở
                menuItem.classList.add('active'); // Thêm class active để thêm viền khi click
            } else {
                menu.style.maxHeight = '0'; // Đóng menu con
                arrow.innerHTML = '▶'; // Mũi tên ngang khi đóng
                menuItem.classList.remove('active'); // Bỏ class active
            }
        }

        // Hiển thị nội dung tương ứng khi click vào mục menu con
        function showPanel(panelId) {
            // Ẩn tất cả các panel trước
            const allPanels = document.querySelectorAll('.panel');
            allPanels.forEach(panel => panel.classList.add('hidden'));

            // Hiển thị panel được chọn
            const panel = document.getElementById(panelId);
            if (panel) {
                panel.classList.remove('hidden'); // Hiển thị panel
            } else {
                console.error(`Phần tử với ID ${panelId} không tồn tại.`);
            }
        }

        //Thoát chương trình
        document.getElementById('user-info-link').addEventListener('click', function () {
            window.location.href = '/logout'; // Chuyển hướng tới trang logout
        });

        // Đóng các menu khác và mở menu "Thống kê" khi trang dm-hoatdongbenhvien được tải
        document.addEventListener('DOMContentLoaded', function () {
            const urlParams = new URLSearchParams(window.location.search);
            const loadHoatDongBenhVien = urlParams.get('loadHoatDongBenhVien');

            // Nếu `loadHoatDongBenhVien` có giá trị `true`, tự động tải `dm-hoatdongbenhvien`
            if (loadHoatDongBenhVien === 'true') {
                loadhoatdongbenhvien(); // Gọi hàm load `dm-hoatdongbenhvien`
                toggleMenu('menu2', document.querySelector('#menu2').parentNode); // Mở menu "Thống kê"
            }
        });
        document.getElementById('toggle-sidebar-btn').addEventListener('click', function () {
            const mainElement = document.querySelector('.main');
            const sidebar = document.getElementById('sidebar-area');
            const overlay = document.getElementById('sidebarOverlay');

            if (window.innerWidth <= 768) {
                // Mobile: dùng drawer + overlay
                if (sidebar.classList.contains('is-open')) {
                    sidebar.classList.remove('is-open');
                    if (overlay) overlay.classList.remove('is-visible');
                    document.body.style.overflow = '';
                } else {
                    sidebar.classList.add('is-open');
                    if (overlay) overlay.classList.add('is-visible');
                    document.body.style.overflow = 'hidden';
                }
            } else {
                // Desktop: ẩn/hiện sidebar như cũ
                if (mainElement.classList.contains('sidebar-hidden')) {
                    mainElement.classList.remove('sidebar-hidden');
                } else {
                    mainElement.classList.add('sidebar-hidden');
                }
            }
        });

        // Đóng sidebar mobile khi click overlay
        document.getElementById('sidebarOverlay').addEventListener('click', function () {
            const sidebar = document.getElementById('sidebar-area');
            if (window.innerWidth <= 768 && sidebar.classList.contains('is-open')) {
                sidebar.classList.remove('is-open');
                this.classList.remove('is-visible');
                document.body.style.overflow = '';
            }
        });

        // Khi resize lên desktop: đóng drawer và ẩn overlay
        window.addEventListener('resize', function () {
            if (window.innerWidth > 768) {
                const sidebar = document.getElementById('sidebar-area');
                const overlay = document.getElementById('sidebarOverlay');
                if (sidebar) sidebar.classList.remove('is-open');
                if (overlay) overlay.classList.remove('is-visible');
                document.body.style.overflow = '';
            }
        });

        //login Tổng số người truy cập
        let isShowingLogins = false;

        function fetchTotalLogins() {
            return fetch('/api/total-logins')
                .then(response => response.json())
                .then(data => data.total || 0)
                .catch(error => {
                    console.error('Lỗi khi lấy tổng số lượt truy cập:', error);
                    return 0; // Trả về 0 nếu có lỗi
                });
        }

        function isMobileView() {
            return window.matchMedia('(max-width: 768px)').matches;
        }

        function updateMobileUserInfo(totalLogins) {
            const el = document.getElementById('user-info-total-mobile');
            if (el && totalLogins !== undefined) {
                el.textContent = ' · ' + totalLogins;
            }
        }

        function toggleUserInfo() {
            const profilePanel = document.getElementById('user-info-profile');
            const loginsPanel = document.getElementById('user-info-logins');
            const loginCountEl = document.getElementById('user-info-login-count');

            if (isMobileView()) {
                fetchTotalLogins().then(updateMobileUserInfo);
                return;
            }

            if (isShowingLogins) {
                profilePanel.classList.remove('is-hidden');
                loginsPanel.classList.add('is-hidden');
                isShowingLogins = false;
                return;
            }

            fetchTotalLogins().then(totalLogins => {
                if (loginCountEl) loginCountEl.textContent = totalLogins;
                profilePanel.classList.add('is-hidden');
                loginsPanel.classList.remove('is-hidden');
                isShowingLogins = true;
            });
        }

        // Khởi tạo: tải số lượt sớm để khối header giữ kích thước cố định khi chuyển đổi
        fetchTotalLogins().then(totalLogins => {
            const loginCountEl = document.getElementById('user-info-login-count');
            if (loginCountEl) loginCountEl.textContent = totalLogins;
            if (isMobileView()) updateMobileUserInfo(totalLogins);
        });

        setInterval(function() {
            if (isMobileView()) {
                fetchTotalLogins().then(updateMobileUserInfo);
            } else {
                toggleUserInfo();
            }
        }, 6000);        
        
        // Hàm hiển thị loading
        function showLoading() {
            const loadingOverlay = document.getElementById('loadingOverlay');
            loadingOverlay.style.display = 'flex';
        }

        // Hàm ẩn loading
        function hideLoading() {
            const loadingOverlay = document.getElementById('loadingOverlay');
            loadingOverlay.style.display = 'none';
        }

        // Hàm tạo skeleton loading
        function createSkeletonLoading() {
            return `
                <div class="skeleton-loading skeleton-header"></div>
                ${Array(5).fill('<div class="skeleton-loading skeleton-text"></div>').join('')}
            `;
        }

        // Hàm cập nhật URL trên trình duyệt
        function updateBrowserURL(pageName) {
            // Loại bỏ tiền tố 'dm-' và đuôi '.ejs' từ tên file
            const cleanPageName = pageName.replace('dm-', '').replace('.ejs', '');
            // Cập nhật URL mà không reload trang
            window.history.pushState({}, '', '/' + cleanPageName);
            // Cập nhật title trang
            document.title = 'BCTK - ' + cleanPageName.charAt(0).toUpperCase() + cleanPageName.slice(1);
        }

        // Hàm load chung cho tất cả các trang
        async function loadContent(url) {
            const contentArea = document.getElementById('content-area');
            
            if (window.innerWidth <= 768) {
                const sidebar = document.getElementById('sidebar-area');
                const overlay = document.getElementById('sidebarOverlay');
                if (sidebar) sidebar.classList.remove('is-open');
                if (overlay) overlay.classList.remove('is-visible');
                document.body.style.overflow = '';
            }
            
            try {
                // Hiển thị skeleton loading
                contentArea.innerHTML = createSkeletonLoading();
                showLoading();

                // Thêm độ trễ tối thiểu để hiệu ứng loading mượt mà hơn
                const minDelay = 500; // 500ms
                const startTime = Date.now();

                // Fetch dữ liệu
                const response = await fetch(url);
                if (!response.ok) throw new Error('Network response was not ok');
                const html = await response.text();

                // Tính thời gian đã trôi qua
                const elapsedTime = Date.now() - startTime;
                
                // Nếu load quá nhanh, đợi thêm một chút để hiệu ứng mượt mà hơn
                if (elapsedTime < minDelay) {
                    await new Promise(resolve => setTimeout(resolve, minDelay - elapsedTime));
                }

                // Hiệu ứng fade out nội dung cũ
                contentArea.style.opacity = '0';
                
                // Đợi hiệu ứng fade out hoàn thành
                await new Promise(resolve => setTimeout(resolve, 300));

                // Cập nhật nội dung và fade in
                contentArea.innerHTML = html;
                contentArea.style.opacity = '1';

                // Khởi tạo lại các script trong content mới được load
                // Tìm và thực thi các script tag trong HTML vừa load
                const scripts = contentArea.querySelectorAll('script');
                scripts.forEach(oldScript => {
                    const newScript = document.createElement('script');
                    Array.from(oldScript.attributes).forEach(attr => {
                        newScript.setAttribute(attr.name, attr.value);
                    });
                    newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                });

                // Đảm bảo các event listeners được khởi tạo lại sau khi content được load
                // Đợi một chút để DOM hoàn toàn sẵn sàng
                setTimeout(() => {
                    // Trigger một custom event để các script trong content có thể lắng nghe
                    const event = new CustomEvent('contentLoaded', { detail: { url } });
                    contentArea.dispatchEvent(event);
                }, 100);

                // Cập nhật URL và title
                const cleanUrl = url.replace('/views/dm-', '/').replace('.ejs', '');
                window.history.pushState({}, '', cleanUrl);
                document.title = 'BCTK - ' + cleanUrl.substring(1).charAt(0).toUpperCase() + cleanUrl.slice(2);

            } catch (error) {
                console.error('Lỗi khi tải nội dung:', error);
                contentArea.innerHTML = `
                    <div style="text-align: center; padding: 20px;">
                        <h2 style="color: red;">Có lỗi xảy ra khi tải nội dung</h2>
                        <p>Vui lòng thử lại sau hoặc liên hệ quản trị viên.</p>
                    </div>
                `;
            } finally {
                hideLoading();
            }
        }

        // Xử lý sự kiện popstate khi người dùng nhấn nút back/forward của trình duyệt
        window.addEventListener('popstate', function(event) {
            const path = window.location.pathname;
            if (path === '/') {
                // Trang chủ
                document.getElementById('content-area').innerHTML = '';
                document.title = 'BCTK - Trang chủ';
            } else {
                // Load nội dung tương ứng
                loadContent(path);
            }
        });

        // Hàm xử lý khi click vào menu item
        function handleMenuItemClick(menuItemElement, loadFunction) {
            // Bỏ active tất cả các menu items
            document.querySelectorAll('.submenu li').forEach(item => {
                item.style.backgroundColor = ''; // Trả về màu mặc định
                item.style.color = ''; // Trả về màu chữ mặc định
            });

            // Active menu item được click
            menuItemElement.style.backgroundColor = '#1a75ff';
            menuItemElement.style.color = 'white';

            // Trên mobile: đóng drawer sau khi chọn
            if (window.innerWidth <= 768) {
                const sidebar = document.getElementById('sidebar-area');
                const overlay = document.getElementById('sidebarOverlay');
                if (sidebar) sidebar.classList.remove('is-open');
                if (overlay) overlay.classList.remove('is-visible');
                document.body.style.overflow = '';
            }

            // Gọi hàm load nội dung
            loadFunction();
        }

