        // Cập nhật hàm xử lý tải trang ban đầu
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const loadHoatDongBenhVien = urlParams.get('loadHoatDongBenhVien');

            if (loadHoatDongBenhVien === 'true') {
                // Mở menu Thống kê
                const menu = document.getElementById('menu2');
                const parentLi = menu.parentElement;
                const arrow = document.getElementById('arrow-menu2');

                // Đóng tất cả các menu trước
                closeAllMenus();

                // Mở menu cha
                menu.style.maxHeight = menu.scrollHeight + 'px';
                parentLi.classList.add('active');
                arrow.innerHTML = '▼';

                // Active menu Hoạt động bệnh viện
                const menuHDBV = document.querySelector('li[onclick="loadhoatdongbenhvien();"]');
                if (menuHDBV) {
                    handleMenuItemClick(menuHDBV, loadhoatdongbenhvien);
                }
            } else {
                const path = window.location.pathname;
                if (path !== '/') {
                    loadContent(path);
                }
            }
        });

